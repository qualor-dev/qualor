# Copy to deploy/.env and fill in. docker compose refuses to start while any of the three secrets
# below is empty: there are no default passwords. Generate each one, for example with
#   openssl rand -hex 32
# (or: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))").
# Hex keeps the database password safe inside the postgres:// URL the server is given.
# Keep deploy/.env out of version control (it is git-ignored) and readable only by you.

# The database password. Set it before the first start; changing it later means changing it in
# PostgreSQL too (deploy/README.md).
POSTGRES_PASSWORD=

# Keys session CSRF tokens and encrypts stored webhook secrets. At least 32 characters. Changing
# it signs everyone out and makes webhook secrets unreadable.
QUALOR_SECRET_KEY=

# The first instance admin, created on the first start only (at least 12 characters). Sign in as
# QUALOR_BOOTSTRAP_ADMIN_USERNAME with it, then change it in the UI; later values are ignored.
QUALOR_BOOTSTRAP_ADMIN_PASSWORD=
# QUALOR_BOOTSTRAP_ADMIN_USERNAME=admin

# Where the server listens on this host. Keep 127.0.0.1 behind a reverse proxy on the same host.
# QUALOR_BIND_ADDRESS=127.0.0.1
# QUALOR_PORT=8080

# The reverse proxy in front of the server: a hop count or its addresses
# (see https://qualor.dev/docs/install-server).
# QUALOR_TRUST_PROXY=1

# QUALOR_LOG_LEVEL=info
# The server image to run. Compose never pulls it (pull_policy: never): by default it builds
# qualor/server:dev from this checkout. For a release, `docker pull qualor/server:<version>` first,
# set it here and start with `docker compose ... up -d --no-build` (deploy/README.md).
# QUALOR_SERVER_IMAGE=qualor/server:dev
