{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Qualor chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
    "tag": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$",
      "not": { "pattern": "^[Ll][Aa][Tt][Ee][Ss][Tt]$" }
    },
    "quantity": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|k|M|G|T)?$" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
        "limits": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "$ref": "#/definitions/tag" },
        "digest": { "$ref": "#/definitions/digest" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["embedded", "external", "bundled"] },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "urlKey": { "type": "string", "minLength": 1 },
            "caSecret": { "type": "string" },
            "caKey": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
          }
        },
        "bundled": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "$ref": "#/definitions/tag" },
                "digest": { "$ref": "#/definitions/digest" }
              }
            },
            "existingSecret": { "type": "string" },
            "password": { "type": "string", "pattern": "^([0-9a-fA-F]{32,})?$" },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": { "$ref": "#/definitions/quantity" },
                "storageClass": { "type": "string" }
              }
            },
            "resources": { "$ref": "#/definitions/resources" }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "$ref": "#/definitions/quantity" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"] }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "anyOf": [{ "maxLength": 0 }, { "minLength": 32 }] },
        "bootstrapAdminPassword": { "type": "string", "anyOf": [{ "maxLength": 0 }, { "minLength": 12 }] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bootstrapAdminUsername": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "publicUrl": { "type": "string", "pattern": "^(https?://\\S+)?$" },
        "trustProxy": {
          "type": "string",
          "pattern": "^(|[1-9][0-9]?|100|(loopback|linklocal|uniquelocal|([0-9]{1,3}(\\.[0-9]{1,3}){3}|[0-9A-Fa-f]*:[0-9A-Fa-f:.]*)(/[0-9]{1,3})?)( *, *(loopback|linklocal|uniquelocal|([0-9]{1,3}(\\.[0-9]{1,3}){3}|[0-9A-Fa-f]*:[0-9A-Fa-f:.]*)(/[0-9]{1,3})?))*)$"
        },
        "scmInternalHosts": { "type": "string" },
        "llmInternalHosts": { "type": "string" },
        "ssoInternalHosts": { "type": "string" },
        "forcePasswordSignIn": { "type": "boolean" },
        "telemetry": { "type": "boolean" },
        "workerConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
        "logLevel": { "enum": ["error", "warn", "info", "debug"] }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": "integer", "minimum": 30000, "maximum": 32767 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "secretName": { "type": "string" } }
        },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "type": "object" } },
        "egress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "resources": { "$ref": "#/definitions/resources" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" }, "name": { "type": "string" } }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
