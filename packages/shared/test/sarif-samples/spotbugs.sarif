          "rules": [
            {
              "id": "ES_COMPARING_PARAMETER_STRING_WITH_EQ",
              "shortDescription": {
                "text": "Comparison of String parameter using == or !=."
              },
              "fullDescription": {
                "text": "This code compares a java.lang.String parameter for reference equality using \nthe == or != operators. Requiring callers to pass only String constants or \ninterned strings to a method is unnecessarily fragile, and rarely leads to \nmeasurable performance gains. Consider using the equals(Object) method instead. \n\nSee CWE-595: Comparison of Object References Instead of Object Contents."
              },
              "messageStrings": {
                "default": {
                  "text": "Comparison of String parameter using == or != in {0}."
                }
              },
              "helpUri": "https://spotbugs.readthedocs.io/en/latest/bugDescriptions.html#ES_COMPARING_PARAMETER_STRING_WITH_EQ",
              "properties": {
                "tags": ["BAD_PRACTICE"]
              },
              "relationships": [
                {
                  "target": {
                    "id": "595",
                    "guid": "08ab604b-e79e-5d94-9bc9-a10ec48774f1",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "b8c54a32-de19-51d2-9a08-f0abfbaa7310"
                    }
                  },
                  "kinds": ["superset"]
                }
              ]
            },
            {
              "id": "UUF_UNUSED_FIELD",
              "shortDescription": {
                "text": "Unused field."
              },
              "fullDescription": {
                "text": "This field is never used.  Consider removing it from the class. \nSee CWE-563: Assignment to Variable without Use."
              },
              "messageStrings": {
                "default": {
                  "text": "Unused field: {0}."
                }
              },
              "helpUri": "https://spotbugs.readthedocs.io/en/latest/bugDescriptions.html#UUF_UNUSED_FIELD",
              "properties": {
                "tags": ["PERFORMANCE"]
              },
