{
  "$id": "https://qualor.dev/schema/report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "scanner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "platform": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._\\-/:]{1,255}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "version": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "key"
      ]
    },
    "scm": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "gitlab",
            "github",
            "none"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "mainBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mergeRequest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "targetBranch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "sourceBranch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              },
              "required": [
                "id",
                "targetBranch",
                "sourceBranch"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline": {
          "type": "object",
          "properties": {
            "revision": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "merge_base",
                "server_baseline",
                "none"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "unavailable",
                "first_analysis"
              ]
            }
          },
          "required": [
            "revision",
            "kind",
            "status"
          ]
        },
        "renames": {
          "maxItems": 200000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ]
          }
        },
        "gitlab": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            "pipelineId": {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            "mergeRequestEventType": {
              "type": "string",
              "enum": [
                "detached",
                "merged_result",
                "merge_train"
              ]
            }
          }
        },
        "github": {
          "type": "object",
          "properties": {
            "repositoryId": {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            "runId": {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            "checkout": {
              "type": "string",
              "enum": [
                "head",
                "other"
              ]
            }
          }
        }
      },
      "required": [
        "provider",
        "revision",
        "branch",
        "mainBranch",
        "mergeRequest",
        "baseline",
        "renames"
      ]
    },
    "analysisDate": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "engines": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "builtin",
              "external"
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed",
              "skipped",
              "timeout"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rules": {
            "maxItems": 20000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "name": {
                  "type": "string",
                  "maxLength": 512
                },
                "shortDescription": {
                  "type": "string",
                  "maxLength": 4000
                },
                "helpUri": {
                  "type": "string",
                  "maxLength": 2048
                },
                "defaultSeverity": {
                  "type": "string",
                  "enum": [
                    "blocker",
                    "high",
                    "medium",
                    "low",
                    "info"
                  ]
                },
                "quality": {
                  "type": "string",
                  "enum": [
                    "security",
                    "reliability",
                    "maintainability"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "issue",
                    "hotspot"
                  ]
                },
                "tags": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "cwe": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "languages": {
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 64
                  }
                }
              },
              "required": [
                "id"
              ]
            }
          },
          "database": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "updatedAt": {
                "type": "string",
                "maxLength": 64,
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "name",
              "updatedAt"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "durationMs",
          "rules"
        ]
      }
    },
    "files": {
      "maxItems": 200000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "enum": [
              "typescript",
              "javascript",
              "java",
              "csharp",
              "python",
              "html",
              "css",
              "kotlin",
              "swift",
              "ruby",
              "other"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "main",
              "test"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "lines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "metrics": {
            "type": "object",
            "properties": {
              "ncloc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "commentLines": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "functions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "classes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "statements": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "complexity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cognitiveComplexity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "ncloc",
              "commentLines",
              "functions",
              "classes",
              "statements",
              "complexity",
              "cognitiveComplexity"
            ]
          },
          "newLines": {
            "anyOf": [
              {
                "type": "string",
                "const": "all"
              },
              {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            ]
          },
          "coverage": {
            "type": "object",
            "properties": {
              "covered": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "uncovered": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "branches": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            },
            "required": [
              "covered",
              "uncovered",
              "branches"
            ]
          }
        },
        "required": [
          "path",
          "language",
          "kind",
          "sha256",
          "lines"
        ]
      }
    },
    "findings": {
      "maxItems": 500000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "engineId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "ruleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "startLine": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "startColumn": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "endColumn": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "path",
                  "startLine"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "secondaryLocations": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "startColumn": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "endColumn": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "message": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "required": [
                "path",
                "startLine"
              ]
            }
          },
          "lineHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "contextHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "snippet": {
            "type": "object",
            "properties": {
              "startLine": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "lines": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 400
                }
              }
            },
            "required": [
              "startLine",
              "lines"
            ]
          },
          "partialFingerprints": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 128
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 256
            },
            "maxProperties": 16
          },
          "properties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "engineId",
          "ruleId",
          "message",
          "location",
          "lineHash",
          "contextHash"
        ]
      }
    },
    "duplications": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blocks": {
            "minItems": 2,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "path",
                "startLine",
                "endLine"
              ]
            }
          }
        },
        "required": [
          "blocks"
        ]
      }
    },
    "warnings": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "maxLength": 4000
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "scanner",
    "project",
    "scm",
    "analysisDate",
    "engines",
    "files",
    "findings",
    "duplications",
    "warnings"
  ]
}
